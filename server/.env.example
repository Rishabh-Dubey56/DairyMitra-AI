# ==========================================
# DairyMitra AI - Production Environment Config
# ==========================================

# Server Basics
NODE_ENV=development
PORT=5001
APP_NAME=DairyMitra-API
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Database (MongoDB Connection Pool)
MONGODB_URI=mongodb://localhost:27017/dairymitra_production
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000

# Cache & Rate Limiting (Redis)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=dm:
REDIS_CONNECT_TIMEOUT_MS=10000
CACHE_DEFAULT_TTL_SEC=300

# Security & Authentication (JWT)
JWT_ACCESS_SECRET=dairymitra_super_secure_access_token_secret_key_2026_production!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=dairymitra_super_secure_refresh_token_secret_key_2026_production!
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=12

# Idempotency & Rate Limiting
IDEMPOTENCY_TTL_SEC=86400
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Bloom Filter & Anti-Abuse
BLOOM_FILTER_EXPECTED_ITEMS=100000
BLOOM_FILTER_FALSE_POSITIVE_RATE=0.01

# Mailer (Nodemailer for OTP & Alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@dairymitra.ai
SMTP_PASS=app_password_here
SMTP_FROM="DairyMitra AI" <notifications@dairymitra.ai>
OTP_EXPIRY_MINUTES=10

# Seed Admin Account
ADMIN_NAME="Rishabh Dubey (Super Admin)"
ADMIN_EMAIL=admin@dairymitra.ai
ADMIN_PASSWORD=Admin@DairyMitra2026!
ADMIN_PHONE=+919876543210
ADMIN_FARM="Gokul Central AI Farm"

# AI Advisor Integration
GEMINI_API_KEY=mock_or_real_key_here
GEMINI_MODEL=gemini-2.0-flash

# Logging & Monitoring
LOG_LEVEL=debug
STRUCTURED_LOGS=true
